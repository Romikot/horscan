<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Daemon application"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LazDaemon"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="hscansrrv.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="daemonmapper.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DaemonMapper1"/>
        <ResourceBaseClass Value="Other"/>
        <ResourceBaseClassname Value="TDaemonMapper"/>
      </Unit>
      <Unit>
        <Filename Value="daemon.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="Daemon1"/>
        <ResourceBaseClass Value="DataModule"/>
      </Unit>
      <Unit>
        <Filename Value="modules\helpers.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Helpers"/>
      </Unit>
      <Unit>
        <Filename Value="modules\WIA_TLB.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="modules\wiadefs.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="WIAdefs"/>
      </Unit>
      <Unit>
        <Filename Value="controllers.ping.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="controllers.scanner.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="dataobjects.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="DataObjects"/>
      </Unit>
      <Unit>
        <Filename Value="options.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="optvalues.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="services.storage.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="services.wiascanner.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Services.WiaScanner"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="hscansrrv"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="modules"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
